# Copy to .env (repo root). backend/.env, if present, overrides it; real env vars win over both.

# Any LiteLLM model string. Check https://docs.litellm.ai/docs/providers for current names.
MODEL=gemini/gemini-flash-latest
# Optional: a different (e.g. stronger) model just for the fact-check step
# VERIFIER_MODEL=

# Key for the provider(s) you use (Gemini keys: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Web app login (single user). Required for every private API endpoint.
APP_PASSWORD=
# Signs the session cookie. Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
# If empty, a random secret is used and you are logged out whenever the backend restarts.
SESSION_SECRET=
# Set to true once the app is served over HTTPS
# COOKIE_SECURE=false

# LLM call settings (defaults shown). Temperature unset = provider default;
# Gemini 3 models can loop at temperatures below 1.0.
# LLM_TEMPERATURE=
# LLM_TIMEOUT_S=120
# LLM_NUM_RETRIES=2

# Agent behaviour
# Below this fit score the agent asks before tailoring
LOW_FIT_THRESHOLD=50
# Regenerations after a failed verification
# MAX_VERIFY_RETRIES=2
# Questions about a vague posting before moving on
# MAX_CLARIFICATIONS=2

# Storage and logs. Defaults: backend/outputs/job_agent.db, backend/outputs, INFO.
# Use absolute paths if you override them.
# DATABASE_PATH=
# OUTPUT_DIR=
# LOG_LEVEL=INFO
