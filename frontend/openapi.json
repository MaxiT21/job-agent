            "type": "string"
          },
          "cv_path": {
            "title": "Cv Path",
            "type": "string"
          },
          "fit_score": {
            "title": "Fit Score",
            "type": "number"
          },
          "letter_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Letter Path"
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "ready",
              "applied",
              "interview",
              "offer",
              "rejected",
              "withdrawn"
