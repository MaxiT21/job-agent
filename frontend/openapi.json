        "properties": {
          "posting_text": {
            "anyOf": [
              {
                "maxLength": 50000,
                "minLength": 50,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Posting Text"
          },
          "posting_url": {
            "anyOf": [
              {
                "format": "uri",
                "maxLength": 2083,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Posting Url"
          }
        },
        "title": "StartRun",
        "type": "object"
      },
      "StatusUpdate": {
        "properties": {
          "status": {
            "enum": [
              "ready",
              "applied",
              "interview",
              "offer",
              "rejected",
              "withdrawn"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "StatusUpdate",
        "type": "object"
      },
      "TailoredCV": {
        "properties": {
          "entries": {
            "description": "Ordered by relevance to the posting",
            "items": {
              "$ref": "#/components/schemas/CVEntry"
            },
            "title": "Entries",
            "type": "array"
          },
          "skills": {
            "description": "Only skills present in the profile",
            "items": {
              "type": "string"
            },
            "title": "Skills",
            "type": "array"
          },
          "summary": {
            "$ref": "#/components/schemas/GroundedLine"
          }
        },
        "required": [
          "summary",
          "entries",
          "skills"
        ],
        "title": "TailoredCV",
        "type": "object"
      },
      "Usage": {
        "properties": {
          "calls": {
            "items": {
              "$ref": "#/components/schemas/LLMCall"
            },
            "title": "Calls",
            "type": "array"
          },
          "total_cost_usd": {
            "title": "Total Cost Usd",
            "type": "number"
          },
          "total_latency_s": {
            "title": "Total Latency S",
            "type": "number"
          }
        },
        "required": [
          "calls",
          "total_cost_usd",
          "total_latency_s"
        ],
        "title": "Usage",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VerificationIssue": {
        "properties": {
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "where": {
            "description": "e.g. 'cv.entries[0].bullets[1]' or 'cover_letter[2]'",
            "title": "Where",
            "type": "string"
          }
        },
        "required": [
          "where",
          "text",
          "reason"
        ],
        "title": "VerificationIssue",
        "type": "object"
      },
      "VerificationResult": {
        "properties": {
          "issues": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/VerificationIssue"
            },
            "title": "Issues",
            "type": "array"
          },
          "passed": {
            "title": "Passed",
            "type": "boolean"
          }
        },
        "required": [
          "passed"
        ],
        "title": "VerificationResult",
        "type": "object"
      }
    }
  },
