      "RunView": {
        "properties": {
          "cover_letter": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CoverLetter"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "cv": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TailoredCV"
