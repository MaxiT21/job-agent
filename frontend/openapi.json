            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "created_at",
          "company",
          "title",
          "location",
          "fit_score",
          "cv_path",
          "letter_path",
          "status"
