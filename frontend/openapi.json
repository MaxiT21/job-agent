            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "files": {
            "$ref": "#/components/schemas/Files"
          },
          "fit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FitReport"
              },
              {
                "type": "null"
              }
            ]
          },
          "posting": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobPosting"
              },
              {
                "type": "null"
