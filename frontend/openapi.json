          },
          "step": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Graph node running next, while status=running",
            "title": "Step"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "verification": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VerificationResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "verification_history": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/VerificationResult"
            },
            "title": "Verification History",
            "type": "array"
          },
          "waiting_for": {
            "anyOf": [
              {
                "discriminator": {
                  "mapping": {
                    "approve": "#/components/schemas/ApprovalRequest",
                    "clarify": "#/components/schemas/ClarifyRequest",
                    "low_fit": "#/components/schemas/LowFitRequest",
                    "paste_text": "#/components/schemas/PasteTextRequest"
